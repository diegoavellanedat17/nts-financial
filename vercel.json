{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/gmail/cron.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/gmail/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
